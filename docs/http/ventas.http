# Ejecute las solicitudes en orden. Ajuste @baseUrl a la URL publicada por Aspire.
@baseUrl = http://localhost:5000
@clienteId = 00000000-0000-0000-0000-000000000099

### Crear producto activo para el flujo de cobro
# @name crearProducto
POST {{baseUrl}}/api/productos
Content-Type: application/json
Accept: application/json

{
  "nombre": "Milanesa napolitana",
  "precio": 25.50
}

### Abrir venta (semánticamente, una comanda abierta)
# @name crearVenta
POST {{baseUrl}}/api/ventas
Content-Type: application/json
Accept: application/json

{
  "clienteId": "{{clienteId}}",
  "numeroMesa": 7
}

### Agregar un detalle con snapshot histórico de nombre y precio
# @name agregarDetalle
POST {{baseUrl}}/api/ventas/{{crearVenta.response.body.$.id}}/detalles
Content-Type: application/json
Accept: application/json

{
  "productoMenuId": "{{crearProducto.response.body.$.id}}",
  "cantidad": 2
}

### Cambiar la cantidad de la línea creada
PUT {{baseUrl}}/api/ventas/{{crearVenta.response.body.$.id}}/detalles/{{agregarDetalle.response.body.$.detalles[0].id}}
Content-Type: application/json
Accept: application/json

{
  "nuevaCantidad": 3
}

### Consultar comanda abierta y total derivado
GET {{baseUrl}}/api/ventas/{{crearVenta.response.body.$.id}}
Accept: application/json

### Listar el historial de ventas, desde la mas reciente
GET {{baseUrl}}/api/ventas
Accept: application/json

### Cobrar la venta
POST {{baseUrl}}/api/ventas/{{crearVenta.response.body.$.id}}/pagar
Content-Type: application/json
Accept: application/json

{
  "metodoPago": "Tarjeta"
}

### Consultar resultado pagado
GET {{baseUrl}}/api/ventas/{{crearVenta.response.body.$.id}}
Accept: application/json

### Intentar modificar una venta pagada (esperado: 409 ProblemDetails)
POST {{baseUrl}}/api/ventas/{{crearVenta.response.body.$.id}}/detalles
Content-Type: application/json
Accept: application/problem+json

{
  "productoMenuId": "{{crearProducto.response.body.$.id}}",
  "cantidad": 1
}

### Abrir otra venta para cancelarla
# @name crearVentaParaCancelar
POST {{baseUrl}}/api/ventas
Content-Type: application/json
Accept: application/json

{
  "clienteId": "{{clienteId}}",
  "numeroMesa": 2
}

### Cancelar conservando motivo de auditoría
POST {{baseUrl}}/api/ventas/{{crearVentaParaCancelar.response.body.$.id}}/cancelar
Content-Type: application/json
Accept: application/json

{
  "motivoCancelacion": "El cliente solicitó cancelar antes del cobro."
}

### Consultar resultado cancelado, fecha y motivo
GET {{baseUrl}}/api/ventas/{{crearVentaParaCancelar.response.body.$.id}}
Accept: application/json

### Motivo faltante o vacío (esperado: 400 ProblemDetails)
# @name crearVentaSinMotivo
POST {{baseUrl}}/api/ventas
Content-Type: application/json
Accept: application/json

{
  "numeroMesa": 3
}

POST {{baseUrl}}/api/ventas/{{crearVentaSinMotivo.response.body.$.id}}/cancelar
Content-Type: application/json
Accept: application/problem+json

{
  "motivoCancelacion": ""
}
